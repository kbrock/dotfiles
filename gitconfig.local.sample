[user]
	name = ...
	email = ...
	# dedicated signing-only key -- never added to any authorized_keys.
	# generate per machine: ssh-keygen -t ed25519 -C "git-signing: <email>" -f ~/.ssh/id_ed25519_signing
	# upload the .pub to GitHub as a Signing Key (not Authentication Key), and add it to ~/.ssh/allowed_signers
	signingkey = ~/.ssh/id_ed25519_signing.pub
[github]
	login = ...
	# HTTPS auth (PAT) is handled by the global `credential.helper = osxkeychain` in ~/.gitconfig --
	# no token needed here. First push/fetch prompts once, Keychain stores it after that.
